datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleName {
  SUPER_ADMIN
  VOLUNTEER
}

enum BookStatus {
  ASSIGNED
  SUBMITTED
  PARTIALLY_SUBMITTED
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  fullName     String
  phoneNumber  String?
  role         RoleName    @default(VOLUNTEER)
  auditLogs    AuditLog[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([role])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   Json
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
}

model Sevak {
  id                String               @id @default(uuid())
  sevakCode         String               @unique // Format: e.g. nb202601, nb202602
  fullName          String               // પૂરું નામ
  firstName         String
  lastName          String
  mobile            String               @unique // Strict: Duplicate mobile blocked
  altMobile         String?              // Alternate mobile: Duplicate allowed
  whatsapp          String?              @unique // Strict: Duplicate WhatsApp blocked
  address           String               // પૂરું સરનામું
  mandal            String               // મંડળ
  kshetra           String               // ક્ષેત્ર
  expectedContacts  Int                  // આપ કુલ કેટલા વ્યક્તિઓનો સંપર્ક કરશો?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  assignedBooks     BookAllocation[]
  receipts          SevaReceipt[]
  distributions     PrasadDistribution[]

  @@index([mobile])
  @@index([whatsapp])
  @@index([fullName])
  @@index([sevakCode])
  @@index([createdAt(sort: Desc)])
}

model BookAllocation {
  id         String     @id @default(uuid())
  bookNumber String     @unique // બુક નં.
  sevakId    String
  sevak      Sevak      @relation(fields: [sevakId], references: [id], onDelete: Cascade)
  status     BookStatus @default(ASSIGNED)
  assignedAt DateTime   @default(now())

  // --- Sah-Sevak (Co-volunteer / Assistant) Extensions ---
  sahSevakName    String?     // સહ-સેવક નામ (Optional)
  sahSevakMobile  String?     // સહ-સેવક મોબાઇલ (Optional)

  @@index([bookNumber])
  @@index([sevakId])
  @@index([sahSevakName])
  @@index([sahSevakMobile])
  @@index([assignedAt(sort: Desc)])
}

model SevaReceipt {
  id                String    @id @default(uuid())
  sevakId           String
  sevak             Sevak     @relation(fields: [sevakId], references: [id], onDelete: Cascade)
  bookNumber        String    // બુક નં.
  receiptNo         String    // પહોંચ નં. (FIXED: standalone @unique removed)
  donorName         String?   // પ.ભ.શ્રી (Donor Name)
  donorMobile       String?   // મોબાઇલ નં.
  amount            Decimal   @db.Decimal(12, 2)
  entryDate         DateTime  @default(now())
  createdAt         DateTime  @default(now())

  // --- Prasad Distribution Extensions ---
  prasadDistributed Boolean   @default(false)
  boxesAllocated    Int       @default(0)
  distributedAt     DateTime?
  distributedBy     String?

  // Enforces uniqueness ONLY per book: Book 12 can have 1..10 and Book 13 can have 1..10
  @@unique([bookNumber, receiptNo])
  @@index([receiptNo])
  @@index([bookNumber])
  @@index([donorName])
  @@index([sevakId])
  @@index([prasadDistributed])
  @@index([createdAt(sort: Desc)])
}

model PrasadDistribution {
  id                    String    @id @default(uuid())
  sevakId               String
  sevak                 Sevak     @relation(fields: [sevakId], references: [id], onDelete: Cascade)
  bookNumber            String?   // Track per book allocation (e.g. "1", "2")
  
  // Eligible item quantities (calculated from receipts in book)
  eligibleSmall         Int       @default(0) // Small Box
  eligibleBig           Int       @default(0) // Big Box
  eligibleBiscuit       Int       @default(0) // Biscuit Box
  eligibleChocolate     Int       @default(0) // Chocolate Box

  // Actually distributed physical quantities
  distributedSmall      Int       @default(0) // Small Box
  distributedBig        Int       @default(0) // Big Box
  distributedBiscuit    Int       @default(0) // Biscuit Box
  distributedChocolate  Int       @default(0) // Chocolate Box

  // Third-Party / Representative Collector Tracking
  collectedByName       String?   // Name of person picking up (Sevak, Sah-Sevak, or other representative)
  collectedByMobile     String?   // Mobile of person picking up

  distributedAt         DateTime?
  distributedBy         String?   // Volunteer user who operated desk
  notes                 String?
  updatedAt             DateTime  @updatedAt

  @@unique([sevakId, bookNumber])
  @@index([sevakId])
  @@index([bookNumber])
  @@index([collectedByName])
  @@index([collectedByMobile])
}