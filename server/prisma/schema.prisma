datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleName {
  SUPER_ADMIN
  VOLUNTEER
}

enum BookStatus {
  ASSIGNED
  SUBMITTED
  PARTIALLY_SUBMITTED
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  fullName     String
  phoneNumber  String?
  role         RoleName    @default(VOLUNTEER)
  auditLogs    AuditLog[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([role])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   Json
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
}

model Sevak {
  id                String               @id @default(uuid())
  sevakCode         String               @unique // Format: e.g. nb202601, nb202602
  fullName          String               // પૂરું નામ
  firstName         String
  lastName          String
  mobile            String               @unique // Strict: Duplicate mobile blocked
  altMobile         String?              // Alternate mobile: Duplicate allowed
  whatsapp          String?              @unique // Strict: Duplicate WhatsApp blocked
  address           String               // પૂરું સરનામું
  mandal            String               // મંડળ
  kshetra           String               // ક્ષેત્ર
  expectedContacts  Int                  // આપ કુલ કેટલા વ્યક્તિઓનો સંપર્ક કરશો?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  assignedBooks     BookAllocation[]
  receipts          SevaReceipt[]
  distributions     PrasadDistribution[]
  giftAllocations   SevakGiftAllocation[]   // Relation to volunteer gifts

  @@index([mobile])
  @@index([whatsapp])
  @@index([fullName])
  @@index([sevakCode])
  @@index([createdAt(sort: Desc)])
}

model BookAllocation {
  id         String     @id @default(uuid())
  bookNumber String     @unique // બુક નં.
  sevakId    String
  sevak      Sevak      @relation(fields: [sevakId], references: [id], onDelete: Cascade)
  status     BookStatus @default(ASSIGNED)
  assignedAt DateTime   @default(now())

  // --- Sah-Sevak (Co-volunteer / Assistant) Extensions ---
  sahSevakName    String?     // સહ-સેવક નામ (Optional)
  sahSevakMobile  String?     // સહ-સેવક મોબાઇલ (Optional)

  @@index([bookNumber])
  @@index([sevakId])
  @@index([sahSevakName])
  @@index([sahSevakMobile])
  @@index([assignedAt(sort: Desc)])
}

model SevaReceipt {
  id                String    @id @default(uuid())
  sevakId           String
  sevak             Sevak     @relation(fields: [sevakId], references: [id], onDelete: Cascade)
  bookNumber        String    // બુક નં.
  receiptNo         String    // પહોંચ નં. (FIXED: standalone @unique removed)
  donorName         String?   // પ.ભ.શ્રી (Donor Name)
  donorMobile       String?   // મોબાઇલ નં.
  amount            Decimal   @db.Decimal(12, 2)
  entryDate         DateTime  @default(now())
  createdAt         DateTime  @default(now())

  // --- Prasad Distribution Extensions ---
  prasadDistributed Boolean   @default(false)
  boxesAllocated    Int       @default(0)
  distributedAt     DateTime?
  distributedBy     String?

  // Enforces uniqueness ONLY per book: Book 12 can have 1..10 and Book 13 can have 1..10
  @@unique([bookNumber, receiptNo])
  @@index([receiptNo])
  @@index([bookNumber])
  @@index([donorName])
  @@index([sevakId])
  @@index([prasadDistributed])
  @@index([createdAt(sort: Desc)])
}

model PrasadDistribution {
  id                    String    @id @default(uuid())
  sevakId               String
  sevak                 Sevak     @relation(fields: [sevakId], references: [id], onDelete: Cascade)
  bookNumber            String?   // Track per book

  // Eligible item quantities (calculated strictly from receipt slabs)
  eligibleBag           Int       @default(0) // Slab 1 (₹1 - ₹249)
  eligibleSmall         Int       @default(0) // Slab 2 (₹250 - ₹499)
  eligibleBig           Int       @default(0) // Slabs 3, 4, 5
  eligibleBiscuit       Int       @default(0) // Slabs 4, 5
  eligibleChocolate     Int       @default(0) // Slab 5 (₹5,000 - ₹20,000+)

  // Standard distributed quantities (up to eligible)
  distributedBag        Int       @default(0)
  distributedSmall      Int       @default(0)
  distributedBig        Int       @default(0)
  distributedBiscuit    Int       @default(0)
  distributedChocolate  Int       @default(0)

  // Extra manual allocations (given beyond eligible quota)
  extraBag              Int       @default(0)
  extraSmall            Int       @default(0)
  extraBig              Int       @default(0)
  extraBiscuit          Int       @default(0)
  extraChocolate        Int       @default(0)

  // Third-Party Collector Details
  collectedByName       String?
  collectedByMobile     String?

  distributedAt         DateTime?
  distributedBy         String?
  notes                 String?
  updatedAt             DateTime  @updatedAt

  @@unique([sevakId, bookNumber])
  @@index([sevakId])
  @@index([bookNumber])
  @@index([collectedByName])
  @@index([collectedByMobile])
}

model SevakGiftAllocation {
  id                   String    @id @default(uuid())
  sevakId              String
  sevak                Sevak     @relation(fields: [sevakId], references: [id], onDelete: Cascade)
  
  recipientType        String    // 'SEVAK' or 'SAH_SEVAK'
  recipientName        String    // Name of Sevak or Sah-Sevak receiving the gift
  biscuitBoxesGiven    Int       @default(0)
  chocolateBoxesGiven  Int       @default(0)

  allocatedAt          DateTime  @default(now())
  allocatedBy          String?   // Volunteer user operating the desk
  notes                String?

  @@index([sevakId])
  @@index([recipientType])
  @@index([recipientName])
  @@index([allocatedAt(sort: Desc)])
}